{
  "name": "ius_email_control",
  "version": "1.0.0",
  "description": "IUS Email Control — Enterprise Gmail Operating Platform",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,VITE\" -c \"cyan.bold,green.bold\" \"tsx server/index.ts\" \"vite\"",
    "build": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/index.cjs",
    "build:all": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/index.cjs",
    "start": "node scripts/start.cjs",
    "online": "node scripts/start.cjs --open",
    "app": "node scripts/start.cjs --open",
    "server": "tsx server/index.ts",
    "electron:dev": "electron electron/main.cjs",
    "package:win": "npm run build:all && electron-builder --win",
    "package:win:dir": "npm run build:all && electron-builder --win --dir",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "email-control",
    "gmail",
    "enterprise",
    "ius"
  ],
  "author": "IUS Natura",
  "license": "ISC",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "googleapis": "^181.0.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "br.com.iusnatura.emailcontrol",
    "productName": "IUS Email Control",
    "copyright": "Copyright © 2026 IUS Natura",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "dist-server/index.cjs",
      "electron/**/*",
      "version.json"
    ],
    "asar": true,
    "win": {
      "publisherName": "IUS Natura",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IUS Email Control",
      "uninstallDisplayName": "IUS Email Control",
      "artifactName": "IUS-Email-Control-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "IUS-Email-Control-Portable-${version}.${ext}"
    }
  }
}
